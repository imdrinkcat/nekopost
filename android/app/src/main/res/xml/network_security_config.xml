<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: HTTPS only, system CAs only (user-installed CAs are not trusted).
  ISRG root pinning is done by the forwarder's OkHttp client (M1).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
