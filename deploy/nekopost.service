[Unit]
Description=Nekopost personal message gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=nekopost
Group=nekopost
EnvironmentFile=/etc/nekopost/nekopost.env
# Keep the Go heap small on low-memory hosts.
Environment=GOMEMLIMIT=64MiB
ExecStart=/usr/local/bin/nekopost serve
Restart=always
RestartSec=5
# The service withholds keep-alives if its database or delivery loop wedges.
WatchdogSec=5min
TimeoutStopSec=30

StateDirectory=nekopost
StateDirectoryMode=0700
UMask=0077

# Bind 80/443 without running as root; no other privileges.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandboxing. /proc stays readable for CPU/memory/uptime metrics.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Resource ceilings.
MemoryMax=160M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
