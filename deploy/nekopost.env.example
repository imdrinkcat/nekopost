# nekopost 配置文件（/etc/nekopost/nekopost.env，权限 600，仅 root 可读）
# 修改后执行：systemctl restart nekopost

# ---- 必填 ----
# 指向本服务器的域名（用于自动申请 Let's Encrypt 证书）
NEKOPOST_DOMAIN=osaka.drinkcat.com
# @BotFather 创建 Bot 时给出的 Token
NEKOPOST_TELEGRAM_BOT_TOKEN=
# 管理员的 Telegram 数字用户 ID，多个用逗号分隔
NEKOPOST_TELEGRAM_ADMIN_IDS=

# ---- 可选（以下均为默认值）----
# 消息投递到的聊天 ID；默认是第一个管理员的私聊
#NEKOPOST_TELEGRAM_CHAT_ID=
# autocert：自动 HTTPS（需开放 80/443）；off：纯 HTTP（仅用于反向代理后或测试）
#NEKOPOST_TLS_MODE=autocert
#NEKOPOST_HTTPS_ADDR=:443
#NEKOPOST_HTTP_ADDR=:80
# Let's Encrypt 证书到期提醒邮箱（可留空）
#NEKOPOST_ACME_EMAIL=
#NEKOPOST_DATA_DIR=/var/lib/nekopost
#NEKOPOST_TIMEZONE=Asia/Tokyo
# 消息元数据（不含正文）保留天数
#NEKOPOST_RETENTION_DAYS=30
# 投递失败后最长重试时间
#NEKOPOST_DELIVERY_MAX_AGE=24h
# 未提供幂等键时，同一来源相同内容在此时间内视为重复（0s 关闭）
#NEKOPOST_DEDUPE_WINDOW=60s
#NEKOPOST_MAX_BODY_CHARS=12000
# 每个来源每分钟最多提交条数
#NEKOPOST_SOURCE_RATE_PER_MIN=60
#NEKOPOST_LOG_LEVEL=info

# ---- 短信过滤（可选，见 docs/sms-filter.md）----
# 设置 DeepSeek API Key 后启用：广告 / 垃圾短信不推送，可在 Bot「🗑 已过滤」中找回
#NEKOPOST_DEEPSEEK_API_KEY=
#NEKOPOST_DEEPSEEK_MODEL=deepseek-flash
#NEKOPOST_DEEPSEEK_API_BASE=https://api.deepseek.com
# 需要分类的消息类型
#NEKOPOST_FILTER_TYPES=sms
# 不推送的类别（可选 finance/logistics/personal/service/roaming/marketing/spam）
#NEKOPOST_FILTER_DROP=roaming,marketing,spam
# 被过滤的短信可以找回的天数
#NEKOPOST_FILTER_KEEP_DAYS=7
